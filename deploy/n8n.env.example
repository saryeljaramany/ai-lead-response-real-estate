# Secrets for the n8n container ONLY. Copy to deploy/n8n.env (git-ignored).
# Public base URL n8n uses to build webhook URLs (Caddy serves it). Keep the trailing slash.
WEBHOOK_URL=https://your-name.duckdns.org/
# Must equal API_SECRET_KEY in backend.env.
BACKEND_API_KEY=
SLACK_LEADS_WEBHOOK_URL=
SLACK_ALERTS_WEBHOOK_URL=
# Leave empty for a public form (a browser form cannot hold a secret).
WEBHOOK_SHARED_SECRET=
