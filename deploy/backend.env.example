# Secrets for the FastAPI container ONLY. Copy to deploy/backend.env (git-ignored).
APP_TITLE=Real Estate Leads API
APP_VERSION=1.0.0
APP_DESCRIPTION=A FastAPI application for managing real estate leads.
# Shared secret for the X-API-Key header, at least 24 characters. Generate: openssl rand -hex 32
API_SECRET_KEY=
# --- AI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# --- Gmail (redirect URI must also be added in Google Cloud Console)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://your-name.duckdns.org/email/auth/callback
GMAIL_SENDER_EMAIL=
GMAIL_DRY_RUN=true
# --- Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_DRY_RUN=true
# --- Supabase (use the sb_secret_ key)
SUPABASE_URL=
SUPABASE_KEY=
# --- HubSpot
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_DRY_RUN=true
# --- Calendly
CALENDLY_LINK=
CALENDLY_UTM_CAMPAIGN=ai_followup
CALENDLY_NAME_FIELDS=single
# --- Pipeline
DEFAULT_COUNTRY_CODE=
# --- CAPTCHA (Cloudflare Turnstile)
# Production secret from the Cloudflare dashboard. NEVER a Cloudflare test secret (1x/2x/3x...):
# the always-pass test secret accepts any token.
TURNSTILE_SECRET_KEY=
# REQUIRED in production: set to the public hostname (e.g. your-name.duckdns.org). It rejects
# tokens issued for other sites and makes a leftover Cloudflare test secret fail (test responses
# report the hostname example.com).
TURNSTILE_EXPECTED_HOSTNAME=
