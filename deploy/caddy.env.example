# Copy to deploy/caddy.env (git-ignored). The hostname must already resolve to the VPS.
APP_DOMAIN=your-name.duckdns.org
# Let's Encrypt sends expiry and problem notices here.
ACME_EMAIL=
# Edge limits for POST /webhook/lead-intake (tune without editing the Caddyfile)
INTAKE_PER_IP_PER_MIN=5
INTAKE_GLOBAL_PER_HOUR=30
INTAKE_GLOBAL_PER_DAY=200
