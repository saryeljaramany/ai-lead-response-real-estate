# Copy to .env.n8n (git-ignored). Never commit real values.
# Pinned to match the n8n version in deploy/docker-compose.yml.
N8N_IMAGE_TAG=2.47.7
TZ=UTC
BACKEND_BASE_URL=http://host.docker.internal:8000
# Must match API_SECRET_KEY in backend.env for authenticated API calls
BACKEND_API_KEY=
SLACK_LEADS_WEBHOOK_URL=
SLACK_ALERTS_WEBHOOK_URL=
# Optional, server-to-server callers only: callers must send header x-webhook-secret
WEBHOOK_SHARED_SECRET=
